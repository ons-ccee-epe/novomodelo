{
  "$schema": "https://raw.githubusercontent.com/ons-ccee-epe/novomodelo/refs/heads/main/schemas/config.schema.json",
  "training": {
    "selection": {
      "method": "sampled",
      "forward_passes": 1
    },
    "stopping_rules": [
      {
        "type": "iteration_limit",
        "limit": 20
      }
    ],
    "scenario_source": {
      "seed": 42,
      "inflow": { "scheme": "out_of_sample" }
    }
  },
  "simulation": {
    "enabled": true,
    "selection": {
      "method": "sampled",
      "num_scenarios": 1
    }
  },
  "modeling": {
    "inflow_non_negativity": {
      "method": "truncation"
    }
  }
}
