{
  "$schema": "https://raw.githubusercontent.com/ons-ccee-epe/novomodelo/refs/heads/main/schemas/config.schema.json",
  "training": {
    "selection": {
      "method": "sampled",
      "forward_passes": 1
    },
    "stopping_rules": [
      {
        "type": "iteration_limit",
        "limit": 5
      }
    ],
    "scenario_source": {
      "seed": 42,
      "inflow": { "scheme": "external" },
      "load": { "scheme": "external" }
    }
  },
  "simulation": {
    "enabled": false
  },
  "modeling": {
    "inflow_non_negativity": {
      "method": "none"
    }
  }
}
