{
  "$schema": "https://raw.githubusercontent.com/ons-ccee-epe/novomodelo/refs/heads/main/schemas/config.schema.json",
  "training": {
    "selection": {
      "method": "sampled",
      "forward_passes": 1
    },
    "stopping_rules": [
      {
        "type": "iteration_limit",
        "limit": 100
      }
    ]
  },
  "simulation": {
    "enabled": false
  },
  "modeling": {
    "inflow_non_negativity": {
      "method": "truncation"
    }
  },
  "estimation": {
    "max_order": 3,
    "order_selection": "pacf",
    "min_observations_per_season": 20
  }
}
