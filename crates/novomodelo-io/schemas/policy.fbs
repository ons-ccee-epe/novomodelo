// SPDX-License-Identifier: Apache-2.0
//
// Novomodelo value-function artifact FlatBuffers schema.
//
// This file is the canonical schema for the binary `.bin` files written
// under a Novomodelo study's `policy/` directory:
//
//   policy/cuts/<pool>.bin       — root: Novomodelo.IO.Policy.StageCuts
//   policy/basis/<node>.bin      — root: Novomodelo.IO.Policy.StageBasis
//   policy/states/<pool>.bin     — root: Novomodelo.IO.Policy.StageStates
//
// The Novomodelo Rust runtime does NOT consume this file; the writer/reader
// in `src/output/policy/` is hand-rolled to satisfy the workspace's
// `unsafe_code = "forbid"` rule. This schema exists for external
// consumers (Python, C++, TypeScript, Java, …) who want a typed reader
// generated by `flatc`.
//
// Drift protection. A conformance test in
// `tests/flatbuffers_schema_conformance.rs`, gated behind the
// `flatc-conformance` cargo feature, round-trips representative buffers
// through both the hand-rolled writer and the `flatc`-generated reader.
// Any change to the field layout in this file MUST be matched by the
// same change to the slot constants in `src/output/policy/codec.rs`
// (and vice versa). The conformance test fails when the two disagree.
//
// Wire-level conventions:
//   • `file_identifier "CBVF"`. Buffers are produced with
//     `FlatBufferBuilder::finish(root, Some("CBVF"))`; the reader rejects any
//     buffer whose leading identifier is not `CBVF`, so a pre-0.14
//     `finish_minimal` buffer (which carries none) is rejected before decoding.
//   • `file_extension "bin"` — the on-disk extension of every policy artifact.
//   • No `root_type`. The root differs per file path; pass
//     `--root-type StageCuts|StageBasis|StageStates` when invoking
//     `flatc -t` or `flatc -b`. Generated code emits `GetRootAsT`
//     for every table T.
//   • Field IDs are explicit on every field. These slots are permanently
//     burned: `AffinePiece` field id 7 (vtable slot 18) held a former
//     always-empty vector field, and `EntitySlot` field id 4 (vtable slot 12)
//     held the former month-integer `delivery_anchor` — both deleted under the
//     0.14 format break; `EntitySlot` field id 5 (vtable slot 14) held the
//     former single-field `delivery_date` anchor, replaced by the per-family
//     `reference_date`/`interval_start`/`interval_end` fields. Format version 4
//     burns `AffinePiece` id 0, `StageCuts` id 5 and `StageBasis` ids 2-6.
//     Each is kept `deprecated` so no future field silently reuses that slot.
//   • A further root, `Novomodelo.IO.Policy.CheckpointManifest`, carries the
//     study-global checkpoint metadata (format version, the policy-graph
//     manifest of nodes/edges, and the producer provenance block). Its field
//     ids start fresh at 0 and reuse none of the burned slots above — those are
//     per-table (`AffinePiece` id 7, `EntitySlot` id 4, `EntitySlot` id 5), so
//     the manifest's own id 4, id 5, and id 7 sit in a distinct vtable and
//     collide with none of them.

namespace Novomodelo.IO.Policy;

file_identifier "CBVF";
file_extension "bin";

/// State-vector dimension class for one entry of an entity manifest.
enum EntityType : byte {
  HydroStorage = 0,
  HydroInflowLag = 1,
  AnticipatedThermalState = 2,
  HydroTransitBucket = 3,
}

/// Per-slot entity identity for one state-vector dimension. Element type of
/// the `entity_manifest` vectors.
///
/// `subindex` is the secondary index within the owning entity: the 1-based AR
/// lag order for `HydroInflowLag`, the ring-buffer slot for
/// `AnticipatedThermalState`, the maturity lag `d` for `HydroTransitBucket`
/// (`entity_id` is the downstream hydro), and `0` for `HydroStorage`.
table EntitySlot {
  /// Dimension class of this state slot.
  entity_type:EntityType (id: 0);

  /// Owning entity's id, matching the `entity_id` columns in `entities.csv`
  /// and `bounds.parquet`.
  entity_id:int32 (id: 1);

  /// Secondary index within the owning entity (per-type meaning above).
  subindex:uint32 (id: 2);

  /// Whether the owning entity was operationally active at this slot's stage.
  was_active:bool (id: 3);

  /// RESERVED — do not reuse. Slot 12 (id 4) held the former month-integer
  /// `delivery_anchor` (`year * 12 + (month - 1)`), replaced by the `YYYYMMDD`
  /// `delivery_date` at id 5 under the 0.14 format break. Marked `deprecated` so
  /// the slot number is permanently burned: an external reader built against the
  /// pre-0.14 schema would otherwise silently decode a `YYYYMMDD` date as a
  /// month integer.
  delivery_anchor:int32 (id: 4, deprecated);

  /// RESERVED — do not reuse. Slot 14 (id 5) held the single-field `YYYYMMDD`
  /// `delivery_date` anchor, replaced by the per-family `reference_date`
  /// (id 6) / `interval_start` (id 7) / `interval_end` (id 8) fields below.
  /// Marked `deprecated` so the slot number is permanently burned: an external
  /// reader built against the pre-per-family schema would otherwise silently
  /// decode one of those fields' `YYYYMMDD` value as the retired single
  /// delivery date.
  delivery_date:int32 (id: 5, deprecated);

  /// `HydroInflowLag`'s reference past stage's `start_date`, `YYYYMMDD`
  /// encoded (`year * 10000 + month * 100 + day`). Sentinel `-2147483648`
  /// (`i32::MIN`) for every other family, and the value a reader yields when
  /// the field is absent from a pre-`id:6` buffer.
  reference_date:int32 (id: 6);

  /// Half-open delivery/arrival interval's inclusive start, `YYYYMMDD`
  /// encoded: `HydroTransitBucket`'s `arrival_start` or
  /// `AnticipatedThermalState`'s `delivery_start`. Sentinel `-2147483648`
  /// (`i32::MIN`) for storage and inflow-lag, and the value a reader yields
  /// when the field is absent from a pre-`id:7` buffer.
  interval_start:int32 (id: 7);

  /// Half-open delivery/arrival interval's exclusive end, paired with
  /// `interval_start`. Sentinel `-2147483648` (`i32::MIN`) for storage and
  /// inflow-lag, and the value a reader yields when the field is absent from a
  /// pre-`id:8` buffer.
  interval_end:int32 (id: 8);
}

/// One affine piece of the piecewise-linear value function. Element type of
/// `StageCuts.cuts`.
///
/// `coefficients` length equals the enclosing `StageCuts.entity_manifest`
/// length. The piece bounds the value function as `intercept + coefficients · x`,
/// in the writer's scaled units (`StageCuts.cost_scale_factor`).
table AffinePiece {
  /// RESERVED — do not reuse. Slot 4 (id 0) held a per-run piece label
  /// removed under format version 4. Marked `deprecated` so the slot number is
  /// permanently burned.
  piece_id:uint64 (id: 0, deprecated);

  /// LP row position. Required for artifact reproducibility and
  /// basis warm-starting.
  slot_index:uint32 (id: 1);

  /// Training iteration that generated this piece.
  iteration:uint32 (id: 2);

  /// Forward-pass index within the generating iteration.
  forward_pass_index:uint32 (id: 3);

  /// Pre-computed affine intercept: `alpha - beta' * x_hat`, where
  /// `x_hat` is the state at the generating forward-pass node. Slot id 4
  /// was the pre-v0.5.0 `domination_count`; reclaimed under the 0.14
  /// format break, which cleanly rejects any earlier artifact.
  intercept:float64 (id: 4);

  /// Gradient coefficient vector. Length equals the enclosing
  /// `StageCuts.entity_manifest` length.
  coefficients:[float64] (id: 5);

  /// Whether this piece is currently active in the LP. Inactive pieces
  /// are retained for potential reactivation.
  is_active:bool (id: 6);

  /// RESERVED — do not reuse. Slot 18 (id 7) held a former always-empty
  /// vector field deleted under the 0.14 format break. Marked `deprecated` so
  /// the slot number is permanently burned for any future field.
  reserved_7:[float64] (id: 7, deprecated);

  /// Whether the writer stored a trial point for this piece when it wrote the
  /// piece's slot. Kept when that point is later dropped; a reader takes it as
  /// written, never from the states table.
  scored:bool (id: 8);

  /// The writer's activity count for this piece; absent unless
  /// `CheckpointManifest.activity_counters` is set.
  active_count:uint64 = null (id: 9);

  /// The writer's last iteration of activity for this piece; absent unless
  /// `CheckpointManifest.activity_counters` is set.
  last_active_iteration:uint64 = null (id: 10);
}

/// Root table for `policy/cuts/<pool>.bin`.
table StageCuts {
  /// Pool id (0-based) — the storage-unit key naming `cuts/<pool>.bin`.
  stage_id:uint32 (id: 0);

  /// The writing study's global state-vector length. A pool that projects
  /// fewer dimensions holds shorter coefficient vectors, of the embedded
  /// `entity_manifest`'s length.
  state_dimension:uint32 (id: 1);

  /// Total preallocated piece slots in the pool.
  capacity:uint32 (id: 2);

  /// Protected-prefix length: the leading slots the writing run started with.
  warm_start_count:uint32 (id: 3);

  /// Pieces held for this pool, strictly ascending by `slot_index`. Length
  /// equals `populated_count`.
  cuts:[AffinePiece] (id: 4);

  /// RESERVED — do not reuse. Slot 14 (id 5) held a list of active piece
  /// indices removed under format version 4; `AffinePiece.is_active` carries
  /// the same fact. Marked `deprecated` so the slot number is permanently
  /// burned.
  active_cut_indices:[uint32] (id: 5, deprecated);

  /// Number of pieces. Equals `cuts.length`.
  populated_count:uint32 (id: 6);

  /// Per-slot entity identity, one entry per coefficient of each piece.
  entity_manifest:[EntitySlot] (id: 7);

  /// The scale of every piece's `intercept` and `coefficients`: the objective
  /// cost-scale factor of the writing study, whose scaled units they are in.
  /// A reader yields no value (absent) for a buffer without it.
  cost_scale_factor:float64 (id: 8);

  /// Owning node's policy-graph id when this pool has a single owner, else `-1`
  /// (a shared pool, which is never a boundary source). Default `-1` is also the
  /// value a reader yields when the field is absent from a pre-`id:8` buffer.
  node_id:int32 = -1 (id: 9);

  /// Graph-stage id of the node(s) owning this pool (`pool_stage` resolved
  /// through the study stage ids) — the boundary-resolution key. Default `-1` is
  /// also the value a reader yields when the field is absent from a pre-`id:8`
  /// buffer.
  graph_stage_id:int32 = -1 (id: 10);

  /// Owning stage's `end_date` — the instant this pool's pieces price —
  /// encoded `year * 10000 + month * 100 + day`. No schema default: a reader
  /// yields `i32::MIN` (never `-1`, a decodable date) for a pre-`id:11`
  /// buffer or a value not yet recorded.
  priced_state_date:int32 (id: 11);
}

/// One scenario's LP simplex basis at a node. Element type of
/// `StageBasis.entries`. `column_status`/`row_status` bytes are the canonical
/// BasisStatus discriminant space (0..=6).
table BasisEntry {
  /// Global scenario index holding this basis.
  scenario:uint32 (id: 0);

  /// Canonical BasisStatus discriminant per LP column (variable).
  column_status:[uint8] (id: 1);

  /// Canonical BasisStatus discriminant per LP row (constraint).
  row_status:[uint8] (id: 2);

  /// Pool slot of each trailing affine-piece row of `row_status`: entry `i` is
  /// the slot of the `i`-th piece row.
  piece_row_slots:[uint32] (id: 3);
}

/// Root table for `policy/basis/<node>.bin`: the LP simplex bases stored at
/// one node.
table StageBasis {
  /// Node position (0-based) — the storage-unit key naming `basis/<node>.bin`.
  stage_id:uint32 (id: 0);

  /// Training iteration that produced these bases.
  iteration:uint32 (id: 1);

  /// RESERVED — do not reuse. Ids 2-6 held a single basis (column and row
  /// counts, the two status vectors and a trailing piece-row count), replaced
  /// by `entries` under format version 4. Marked `deprecated` so the slot
  /// numbers are permanently burned.
  num_columns:uint32 (id: 2, deprecated);

  /// RESERVED — do not reuse (see `num_columns`).
  num_rows:uint32 (id: 3, deprecated);

  /// RESERVED — do not reuse (see `num_columns`).
  column_status:[uint8] (id: 4, deprecated);

  /// RESERVED — do not reuse (see `num_columns`).
  row_status:[uint8] (id: 5, deprecated);

  /// RESERVED — do not reuse (see `num_columns`).
  num_cut_rows:uint32 (id: 6, deprecated);

  /// One entry per global scenario holding a basis at this node, ascending by
  /// `scenario`.
  entries:[BasisEntry] (id: 7);
}

/// Root table for `policy/states/<pool>.bin`.
///
/// The trial points one pool stores, one per stored slot. Written for every
/// pool that stores trial points.
table StageStates {
  /// Pool id (0-based) — the same key as `StageCuts.stage_id`.
  stage_id:uint32 (id: 0);

  /// Length of each state vector: the pool's `StageCuts.entity_manifest`
  /// length.
  state_dimension:uint32 (id: 1);

  /// Number of state vectors stored.
  count:uint32 (id: 2);

  /// Flat row-major buffer; length equals `count * state_dimension`.
  data:[float64] (id: 3);

  /// Per-slot entity identity. Length equals `StageStates.state_dimension`.
  entity_manifest:[EntitySlot] (id: 4);

  /// Declared id of the pool's sole owning node, or `-1` for a shared pool.
  /// Default `-1` is also the value a reader yields when the field is absent.
  node_id:int32 = -1 (id: 5);

  /// Pool slot of each stored row, strictly ascending. Length equals `count`;
  /// each slot holds a piece whose `scored` is set.
  slots:[uint32] (id: 6);
}

/// One node of the checkpoint's policy-graph manifest. Element type of
/// `CheckpointManifest.nodes`.
///
/// `pool_id` is the node → pool map: a reader resolves node `id`'s affine pieces
/// as `pool_id`'s `StageCuts` payload (leaf nodes sharing a pool name the same
/// `pool_id`).
table ManifestNode {
  /// Declared node id.
  id:int32 (id: 0);

  /// Graph-stage id this node sits at.
  stage_id:int32 (id: 1);

  /// Pool whose payload holds this node's affine pieces.
  pool_id:uint32 (id: 2);
}

/// One directed edge of the policy-graph manifest, with its transition
/// probability. Element type of `CheckpointManifest.edges`.
table ManifestEdge {
  /// Source node id.
  source_id:int32 (id: 0);

  /// Target node id.
  target_id:int32 (id: 1);

  /// Transition probability `P(source -> target)`.
  probability:float64 (id: 2);
}

// SeasonManifest and HydroSeasonOrders field ids start fresh at 0, distinct
// from CheckpointManifest's own vtable; they collide with no burned slot.

/// One hydro's per-season autoregressive order vector. Element type of
/// `SeasonManifest.hydro_orders`.
table HydroSeasonOrders {
  /// Owning hydro's id.
  hydro_id:int32 (id: 0);

  /// Consecutive-lag AR order per dense season ordinal — a count, never a
  /// lag set. Length equals `SeasonManifest.n_seasons`.
  orders:[uint32] (id: 1);
}

/// Study-global season cycle and per-hydro PAR-order descriptor, carried on
/// `CheckpointManifest`. The date-driven boundary gate compares two studies'
/// descriptors to reject a source whose season definitions or per-season AR
/// orders differ from the loading study's.
table SeasonManifest {
  /// Season cycle discriminant: 0 monthly, 1 weekly, 2 custom, 255 no season
  /// map declared (absent). A raw discriminant, never an algorithm-specific
  /// season enum — see the `SEASON_CYCLE_CODE_*` constants in
  /// `src/output/policy/records.rs`. Default `255` (not the type's implicit
  /// `0`) so a `flatc`-built buffer elides this field only when it is
  /// genuinely absent, never when it happens to equal the real "monthly" (0)
  /// value — matching the `StageCuts.node_id = -1` precedent above.
  cycle_code:uint8 = 255 (id: 0);

  /// Number of distinct seasons in the cycle; the length of every
  /// `HydroSeasonOrders.orders` vector.
  n_seasons:uint32 (id: 1);

  /// Per-hydro AR order vectors, in canonical ascending `hydro_id` order.
  hydro_orders:[HydroSeasonOrders] (id: 2);
}

/// Root table for the study-global checkpoint manifest: the artifact format
/// version, the stage count, the policy-graph manifest (nodes, edges, pool-set
/// size), and the producer provenance block.
///
/// Field ids start fresh at 0 and reuse none of the burned slots noted in the
/// header (those are per-table: `AffinePiece` id 7, `EntitySlot` id 4). The
/// three `float64` provenance fields (`final_lower_bound`, `best_upper_bound`,
/// `cost_scale_factor`) carry no explicit default, so an absent field decodes as
/// "no value recorded" rather than a spurious `0.0`.
table CheckpointManifest {
  /// On-disk artifact format version; a reader rejects any other value.
  format_version:uint32 (id: 0);

  /// Version of the software that wrote this checkpoint.
  software_version:string (id: 1);

  /// ISO 8601 timestamp when the checkpoint was written.
  created_at:string (id: 2);

  /// Number of stages the graph manifest spans.
  num_stages:uint32 (id: 3);

  /// Number of distinct pools (the pool-set size).
  n_pools:uint32 (id: 4);

  /// Graph-manifest nodes, in canonical order.
  nodes:[ManifestNode] (id: 5);

  /// Graph-manifest directed edges with their transition probabilities.
  edges:[ManifestEdge] (id: 6);

  /// Producer training iterations completed at write time.
  completed_iterations:uint32 (id: 7);

  /// Lower bound after the final completed iteration.
  final_lower_bound:float64 (id: 8);

  /// Last iteration's upper bound; absent when the producer recorded none.
  best_upper_bound:float64 (id: 9);

  /// Maximum iterations configured for the run.
  max_iterations:uint32 (id: 10);

  /// Forward passes per iteration.
  forward_passes:uint32 (id: 11);

  /// Pieces loaded from a previous artifact at run start.
  warm_start_cuts:uint32 (id: 12);

  /// Per-pool warm-start piece counts, in pool-id order.
  warm_start_counts:[uint32] (id: 13);

  /// RNG seed used by the scenario sampler.
  rng_seed:uint64 (id: 14);

  /// Total visited states across all nodes.
  total_visited_states:uint64 (id: 15);

  /// Block mode the checkpoint was trained under, or `"mixed"`.
  training_block_mode:string (id: 16);

  /// Per-study-stage block modes, in study-stage order (mixed-mode only).
  training_block_mode_per_stage:[string] (id: 17);

  /// Objective cost-scale factor the writing study resolved; absent when unmarked.
  cost_scale_factor:float64 (id: 18);

  /// Study-global season cycle and per-hydro PAR-order descriptor. A reader
  /// yields the absent descriptor (`SeasonManifest.cycle_code == 255`) for a
  /// pre-`id:19` buffer.
  season_manifest:SeasonManifest (id: 19);

  /// Name of the software that wrote this checkpoint; absent in a buffer older
  /// than this field.
  software:string (id: 20);

  /// Lower bound after each recorded iteration, oldest first; the last entry is
  /// iteration `completed_iterations`. A writer records every completed iteration
  /// it has; an empty or absent vector means none was recorded.
  lower_bound_history:[float64] (id: 21);

  /// Which trial points the pools that are neither the root's nor the
  /// terminal's store: 0 none, 1 those of the last `state_history_window`
  /// iterations, 2 every one. A raw discriminant — see the
  /// `STATE_HISTORY_SCOPE_*` constants in `src/output/policy/records.rs`.
  state_history_scope:uint8 (id: 22);

  /// The window of iterations under scope 1; `0` under every other scope.
  state_history_window:uint32 (id: 23);

  /// Whether every piece of every pool carries `active_count` and
  /// `last_active_iteration`.
  activity_counters:bool (id: 24);

  /// Whether `basis/` holds a basis for every scenario that held one, rather
  /// than one representative per node.
  basis_store_complete:bool (id: 25);
}
