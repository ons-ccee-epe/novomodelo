#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook for Novomodelo
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

echo "==> Running cargo fmt --check..."
cargo fmt --all -- --check

echo "==> Running plan-structure leak check..."
bash scripts/ci/check-no-plan-leaks.sh

echo "==> Running Python parity check..."
python3 scripts/ci/check_python_parity.py --max 0

echo "==> Pre-commit checks passed."
