#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook for Novomodelo
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

echo "==> Running cargo fmt --check..."
cargo fmt --all -- --check

echo "==> Running plan-structure leak check..."
bash scripts/ci/check-no-plan-leaks.sh

echo "==> Running Python parity check..."
python3 scripts/ci/check_python_parity.py --max 0

echo "==> Running Python binding version lockstep check..."
python3 scripts/ci/check_binding_version.py

if git diff --cached --name-only | grep -qE '(^|/)Cargo\.(toml|lock)$|^deny\.toml$'; then
    echo "==> Running cargo-deny (dependency files staged)..."
    bash scripts/ci/check-deny.sh
fi

echo "==> Pre-commit checks passed."
